{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Read(~/notes/**)",
      "Bash(go test:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./secrets/**)"
    ],
    "defaultMode": "default"
  },
  "env": {
    "DOTAI_TOOLS": "/home/user/.dotai/tools"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "other-tool notify"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "example-plugin@example-marketplace": true
  },
  "statusLine": {
    "type": "command",
    "command": "dotai-status"
  }
}
