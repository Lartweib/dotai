{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Read(~/notes/**)"
    ],
    "deny": [
      "Read(./.env)"
    ],
    "defaultMode": "default"
  },
  "env": {},
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "other-tool notify"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "example-plugin@example-marketplace": true
  },
  "statusLine": {
    "type": "command",
    "command": "old-status.sh"
  }
}
