        },
        {
          "kind": "variant",
          "name": "tmux",
          "path": "variants/tmux",
          "items": 2
        },
        {
          "kind": "variant",
          "name": "shared",
          "path": "variants/shared",
          "items": 1
        }
      ]
    },
    "diagnostics": [],
    "warnings": [
      {
        "file": "base/.rulesync/subagents/onboarding.md",
        "line": 0,
        "column": 0,
        "code": "onboarding-duplicate",
        "message": "subagent \"onboarding\" is an onboarding of the pack's own besides dotai's, which the install generates from the manifest's profiles",
        "hint": "remove it, or declare it as onboarding.custom in dotai.yaml to replace dotai's onboarding"
      }
    ]
  }
