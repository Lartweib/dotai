# dotai's per-project directory, which dotai apply writes into a project
# (its marker, the onboarding record and the pack's project files); never committed
.dotai/

# Local tooling and agent working directories
.claude/
.lab/
.atl/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Build and release output: go build ./cmd/dotai at the root, scripts/release.sh
/dotai
/dotai.exe
dist/

# Local environment files
.env
.env.*

# Git bundles
*.bundle

# Coverage and profiling output
*.out
*.cov
coverage.*
*.prof
