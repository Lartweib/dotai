# Line endings follow .gitattributes: LF everywhere but Windows scripts.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[{go.mod,go.sum}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.golden]
insert_final_newline = unset
trim_trailing_whitespace = false

[internal/plan/jsonc/testdata/*crlf*]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
