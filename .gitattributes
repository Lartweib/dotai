# Normalize text files to LF in the repository and the working tree
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary

# Go sources and golden files must be LF on every OS (gofmt and byte-exact goldens)
*.go     text eol=lf
go.mod   text eol=lf
go.sum   text eol=lf
*.golden text eol=lf

# CRLF JSONC fixtures must keep their line endings byte for byte
internal/plan/jsonc/testdata/*crlf* -text
